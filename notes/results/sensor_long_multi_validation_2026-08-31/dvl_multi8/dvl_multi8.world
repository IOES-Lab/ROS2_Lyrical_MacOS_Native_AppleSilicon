              <tracking>
                <water_mass_mode>
                  <when>best</when>
                  <water_velocity>
                    <x>water_vx</x>
                    <y>water_vy</y>
                    <z>water_vz</z>
                  </water_velocity>
                  <boundaries>
                    <near>10.</near>
                    <far>100.</far>
                  </boundaries>
