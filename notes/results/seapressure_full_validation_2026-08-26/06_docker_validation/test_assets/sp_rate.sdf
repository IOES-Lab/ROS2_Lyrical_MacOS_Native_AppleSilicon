<?xml version="1.0"?>
<sdf version="1.7">
  <model name="sp_rate">
    <static>true</static>
    <pose>0 0 0 0 0 0</pose>
    <link name="base_link"/>
    <plugin filename="sea_pressure_sensor"
            name="dave_gz_sensor_plugins::SubseaPressureSensorPlugin">
      <namespace>sp_rate</namespace>
      <update_rate>2</update_rate>
    </plugin>
  </model>
</sdf>
