<?xml version="1.0"?>
<sdf version="1.7">
  <model name="sp_noise">
    <static>true</static>
    <pose>0 0 0 0 0 0</pose>
    <link name="base_link"/>
    <plugin filename="sea_pressure_sensor"
            name="dave_gz_sensor_plugins::SubseaPressureSensorPlugin">
      <namespace>sp_noise</namespace>
      <noise_sigma>0.123</noise_sigma>
    </plugin>
  </model>
</sdf>
