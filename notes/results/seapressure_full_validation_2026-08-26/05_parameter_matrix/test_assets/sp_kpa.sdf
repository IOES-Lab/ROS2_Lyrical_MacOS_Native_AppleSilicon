<?xml version="1.0"?>
<sdf version="1.7">
  <model name="sp_kpa">
    <static>true</static>
    <pose>0 0 -10 0 0 0</pose>
    <link name="base_link"/>
    <plugin filename="sea_pressure_sensor"
            name="dave_gz_sensor_plugins::SubseaPressureSensorPlugin">
      <namespace>sp_kpa</namespace>
      <kPa_per_meter>1.0</kPa_per_meter>
    </plugin>
  </model>
</sdf>
