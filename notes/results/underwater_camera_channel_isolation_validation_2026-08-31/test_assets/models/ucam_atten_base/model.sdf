<?xml version="1.0"?>
<sdf version="1.10">
  <model name="ucam_atten_base">
    <static>true</static>
    <link name="camera_link">
      <sensor name="ucam_atten_base" type="rgbd_camera">
        <update_rate>10</update_rate><visualize>false</visualize><always_on>true</always_on>
        <topic>ucam_atten_base</topic>
        <camera><horizontal_fov>1.05</horizontal_fov><image><width>320</width><height>240</height></image><clip><near>0.1</near><far>10.0</far></clip></camera>
        <plugin filename="UnderwaterCamera" name="dave_gz_sensor_plugins::UnderwaterCamera">
          <attenuationR>0.5</attenuationR><attenuationG>0.5</attenuationG><attenuationB>0.5</attenuationB>
          <backgroundR>0</backgroundR><backgroundG>0</backgroundG><backgroundB>0</backgroundB>
        </plugin>
      </sensor>
    </link>
  </model>
</sdf>
