+    auto send_bool = reinterpret_cast<BoolMessage>(objc_msgSend);
+    void * ns_window = send_id(view, sel_registerName("window"));
+    void * ns_application = send_id(
+      reinterpret_cast<void *>(objc_getClass("NSApplication")),
+      sel_registerName("sharedApplication"));
+    if (ns_window) {
+      send_void(ns_window, sel_registerName("orderFrontRegardless"));
+      send_void(ns_window, sel_registerName("makeKeyWindow"));
