+#ifdef __APPLE__
+  // Diagnostic candidate: Qt reports the RViz top-level frame as visible, but
+  // CoreGraphics records its NSWindow as ordered out after OGRE creates the
+  // external render view. Force that existing NSWindow to the front from
+  // inside RViz after the event loop starts.
+  QTimer::singleShot(1000, frame_, [this]() {
+    void * view = reinterpret_cast<void *>(frame_->winId());
+    using IdMessage = void * (*)(void *, SEL);
+    using VoidMessage = void (*)(void *, SEL);
+    using BoolMessage = void (*)(void *, SEL, bool);
+    auto send_id = reinterpret_cast<IdMessage>(objc_msgSend);
