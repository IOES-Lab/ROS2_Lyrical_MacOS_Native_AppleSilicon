<?xml version="1.0"?>
<sdf version="1.10">
  <model name="ucam_murky">
    <static>true</static>
    <link name="camera_link">
      <sensor name="ucam_murky" type="rgbd_camera">
        <update_rate>10</update_rate>
        <visualize>false</visualize>
        <always_on>true</always_on>
        <topic>ucam_murky</topic>
        <camera>
          <horizontal_fov>1.05</horizontal_fov>
          <image>
            <width>320</width>
            <height>240</height>
          </image>
          <clip>
            <near>0.1</near>
            <far>10.0</far>
          </clip>
        </camera>
        <plugin
          filename="UnderwaterCamera"
          name="dave_gz_sensor_plugins::UnderwaterCamera">
          <attenuationR>0.8</attenuationR>
      <attenuationG>0.5</attenuationG>
      <attenuationB>0.2</attenuationB>
      <backgroundR>85</backgroundR>
      <backgroundG>107</backgroundG>
      <backgroundB>47</backgroundB>
        </plugin>
      </sensor>
    </link>
  </model>
</sdf>
