<?xml version="1.0"?>
<sdf version="1.10">
  <model name="uc_bg_r">
    <static>true</static>
    <link name="camera_link">
      <sensor name="uc_bg_r" type="rgbd_camera">
        <update_rate>10</update_rate>
        <visualize>false</visualize>
        <always_on>true</always_on>
        <topic>uc_bg_r</topic>
        <camera>
          <horizontal_fov>1.05</horizontal_fov>
          <image><width>320</width><height>240</height></image>
          <clip><near>0.1</near><far>10.0</far></clip>
        </camera>
        <plugin filename="UnderwaterCamera" name="dave_gz_sensor_plugins::UnderwaterCamera">
          <attenuationR>0.8</attenuationR>
          <attenuationG>0.8</attenuationG>
          <attenuationB>0.8</attenuationB>
          <backgroundR>85</backgroundR>
        </plugin>
      </sensor>
    </link>
  </model>
</sdf>
