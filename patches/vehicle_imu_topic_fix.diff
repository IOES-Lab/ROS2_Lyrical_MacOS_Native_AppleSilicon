diff --git a/models/dave_robot_models/description/bluerov2/model.sdf b/models/dave_robot_models/description/bluerov2/model.sdf
index 1a3a9b2..15812e2 100644
--- a/models/dave_robot_models/description/bluerov2/model.sdf
+++ b/models/dave_robot_models/description/bluerov2/model.sdf
@@ -45,6 +45,12 @@
         <pose>0 0 0 3.142 0 0</pose>
         <always_on>1</always_on>
         <update_rate>1000.0</update_rate>
+        <!-- Without this tag Gazebo publishes on its default sensor path,
+             /world/WORLD/model/bluerov2/link/base_link/sensor/imu_sensor/imu,
+             while dave_robot_models/config/bluerov2/robot_config.py bridges
+             /model/bluerov2/imu. The ROS topic then exists but stays silent.
+             The camera in this same file declares its topic and works. -->
+        <topic>/model/bluerov2/imu</topic>
       </sensor>
 
     </link>
